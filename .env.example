# Environment Variables for Sathi

# Backend Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_TTL_SECONDS=604800
LOG_LEVEL=INFO

# ==============================================================================
# Supabase Configuration (Backend & PostgreSQL Database)
# ==============================================================================
# 1. Database Connection String (from Supabase: Project Settings -> Database -> Connection string):
#    - Direct Connection (Port 5432):
#      DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#    - Connection Pooling / PgBouncer (Port 6543 - recommended for scalable/serverless backend):
#      DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#    - Local SQLite Fallback:
#      DATABASE_URL=sqlite:///./sathi.db
DATABASE_URL=sqlite:///./sathi.db

# 2. Supabase API Credentials (from Supabase: Project Settings -> API):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==============================================================================
# Frontend Supabase Settings (Vite client exposure)
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# AI Provider Settings
# ==============================================================================
# GEMINI = Gemini 2.0 Flash (recommended), GROQ = Groq Llama, MOCK = no AI
AI_PROVIDER=GEMINI

# Gemini API Key (primary) — get free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (fallback) — get free at https://console.groq.com
GROQ_API_KEY=

# Voice Provider Settings
# Defaults to browser Web Speech API if not provided
VOICE_STT_PROVIDER=BROWSER
VOICE_TTS_PROVIDER=BROWSER
